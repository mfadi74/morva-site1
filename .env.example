# ── AchieveOS environment variables ─────────────────────────────
# Copy this file to `.env` and fill in your own keys.
# The app runs perfectly WITHOUT any of these (local demo mode):
# data is stored on-device and AI insights use the built-in coach.

# Supabase (cloud accounts + sync) — https://supabase.com → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Claude AI (live AI coach) — https://console.anthropic.com → API Keys
# ⚠️ For production, do NOT ship this key inside the app. Use the
# Supabase Edge Function proxy in supabase/functions/ask-claude instead.
EXPO_PUBLIC_CLAUDE_API_KEY=

# Optional: override the Claude model (defaults to claude-sonnet-5)
EXPO_PUBLIC_CLAUDE_MODEL=
